{
    "name": "muchwat/opendataloader-pdf-laravel",
    "description": "Laravel wrapper around the opendataloader-pdf CLI: turn a PDF into Markdown, one string per physical page, via Laravel's Process facade.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "pdf", "markdown", "opendataloader", "opendataloader-pdf", "extraction", "converter"],
    "homepage": "https://github.com/Muchwat/opendataloader-pdf-laravel",
    "authors": [
        {
            "name": "Kevin Muchwat",
            "email": "kevinmuchwat@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/process": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Muchwat\\OpendataloaderPdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Muchwat\\OpendataloaderPdf\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Muchwat\\OpendataloaderPdf\\OpendataloaderPdfServiceProvider"
            ],
            "aliases": {
                "OpendataloaderPdf": "Muchwat\\OpendataloaderPdf\\Facades\\OpendataloaderPdf"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpmd src,config text phpmd.xml.dist",
        "analyse:types": "phpstan analyse --memory-limit=512M",
        "check": [
            "@lint:test",
            "@analyse",
            "@analyse:types",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/Muchwat/opendataloader-pdf-laravel/issues",
        "source": "https://github.com/Muchwat/opendataloader-pdf-laravel"
    },
    "minimum-stability": "stable"
}
